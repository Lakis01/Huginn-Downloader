	optdepends = rsgain: optional ReplayGain normalization
	source = huginn-downloader-@VERSION@-source.tar.gz::https://github.com/Lakis01/Huginn-Downloader/releases/download/v@VERSION@/huginn-downloader-@VERSION@-source.tar.gz
