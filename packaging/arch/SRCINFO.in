pkgbase = firefox-youtube-downloader-companion
	pkgdesc = Local Native Messaging companion for Huginn Downloader
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/Lakis01/Huginn-Downloader
	arch = any
	license = MIT
	depends = python
	optdepends = yt-dlp: downloader backend
