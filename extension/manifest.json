{
  "manifest_version": 2,
  "name": "YouTube Downloader",
  "version": "2.1.0",
  "description": "Send YouTube pages and links to yt-dlp for audio, video, or cut downloads.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-youtube-downloader@lakis01.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "menus",
    "activeTab",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.youtu.be/*",
    "*://youtu.be/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "YouTube Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/plugin.svg",
      "32": "icons/plugin.svg"
    }
  },
  "options_ui": {
    "page": "popup.html?view=options",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/plugin.svg",
    "32": "icons/plugin.svg"
  }
}
