{
  "manifest_version": 2,
  "name": "Huginn Downloader",
  "version": "2.5.9",
  "description": "yt-dlp Browser Extension frontend with custom post-processing pipeline",
  "homepage_url": "https://github.com/Lakis01/Huginn-Downloader",
  "browser_specific_settings": {
    "gecko": {
      "id": "huginn-downloader@lakis01.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "menus",
    "activeTab",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://*.youtu.be/*",
    "*://youtu.be/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
      "default_title": "Huginn Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/huginn-logo.svg",
      "32": "icons/huginn-logo.svg"
    }
  },
  "options_ui": {
    "page": "popup.html?view=options",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/huginn-logo.svg",
    "32": "icons/huginn-logo.svg",
    "48": "icons/huginn-logo.svg",
    "96": "icons/huginn-logo.svg"
  }
}
